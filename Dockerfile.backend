# ==========================================
# ClipMind AI - Production Backend Dockerfile
# ==========================================
FROM python:3.11-slim AS builder

WORKDIR /app

# Install system build dependencies, FFmpeg, and libgomp1 (required by ctranslate2/faster-whisper)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies in a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download the Whisper tiny model at build time (avoids runtime download failures on Render)
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('tiny', device='cpu', compute_type='int8')"

# ==========================================
# Production Runtime Stage
# ==========================================
FROM python:3.11-slim AS runner

WORKDIR /app

# Install runtime dependencies: FFmpeg, curl for healthcheck, libgomp1 for ctranslate2
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder (includes pre-downloaded Whisper model in cache)
COPY --from=builder /opt/venv /opt/venv
# Copy Whisper model cache so it does not need to re-download at runtime
COPY --from=builder /root/.cache /root/.cache

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DATABASE_URL="sqlite:////app/data/clipmind.db"
ENV MAX_UPLOAD_MB="500"

# Create application directories and unprivileged user
RUN groupadd -r clipmind && useradd -r -g clipmind -d /app clipmind && \
    mkdir -p /app/uploads /app/thumbnails /app/data && \
    chown -R clipmind:clipmind /app

# Copy application source code
COPY --chown=clipmind:clipmind app/ /app/app/
COPY --chown=clipmind:clipmind README.md /app/README.md

USER clipmind

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
