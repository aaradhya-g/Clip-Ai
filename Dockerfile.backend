# ==========================================
# ClipMind AI - Production Backend Dockerfile
# ==========================================
FROM python:3.11-slim AS builder

WORKDIR /app

# Install system build dependencies and required runtime libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies in a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Verify faster-whisper imports correctly (does NOT download model, just checks the lib)
RUN python -c "from faster_whisper import WhisperModel; print('faster-whisper OK')" || true

# ==========================================
# Production Runtime Stage
# ==========================================
FROM python:3.11-slim AS runner

WORKDIR /app

# Install runtime dependencies: FFmpeg, curl, libgomp1 (required by ctranslate2/faster-whisper)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DATABASE_URL="sqlite:////app/data/clipmind.db"
ENV MAX_UPLOAD_MB="500"

# Create application directories and unprivileged user
RUN groupadd -r clipmind && useradd -r -g clipmind -d /app clipmind && \
    mkdir -p /app/uploads /app/thumbnails /app/data /app/.cache && \
    chown -R clipmind:clipmind /app

# Copy application source code
COPY --chown=clipmind:clipmind app/ /app/app/
COPY --chown=clipmind:clipmind README.md /app/README.md

USER clipmind

# Set HuggingFace cache to a writable dir inside /app
ENV HF_HOME="/app/.cache"
ENV XDG_CACHE_HOME="/app/.cache"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
